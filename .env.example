# 复制为 .env 后填写；.env 不入库，CI 中请以环境变量注入。
# 模型四项配置请从官方支持的模型列表复制对应值：
# https://midscenejs.com/model-common-config.html
# 完整环境变量参考：https://midscenejs.com/model-config.html
MIDSCENE_MODEL_BASE_URL=
MIDSCENE_MODEL_API_KEY=
MIDSCENE_MODEL_NAME=
MIDSCENE_MODEL_FAMILY=

# 可选：多台设备在线时，通过 adb devices 查询 udid 并在此指定目标设备。
# 未指定时，仅当恰有一台已授权在线设备时才会自动选择。
ANDROID_DEVICE_ID=

# 可选：多台 HarmonyOS 设备在线时，通过 hdc list targets 查询 deviceId
# 并在此指定目标设备。未指定时，仅当恰有一台在线目标时才会自动选择。
# （本变量为本框架级约定，官方 @midscene/harmony 自身不读取该变量。）
HARMONY_DEVICE_ID=

# 可选：多设备协作项目（multi-device）的设备清单。
# 格式：alias:platform:ENV_VAR,alias:platform:ENV_VAR
# 至少两台；别名以字母开头，仅含字母/数字/下划线；平台为 android 或 harmony。
# 未设置时默认：phone1=android / phone2=harmony。
# MULTI_DEVICE_BINDINGS=phone1:android:MULTI_DEVICE_PHONE1_ID,phone2:harmony:MULTI_DEVICE_PHONE2_ID
# MULTI_DEVICE_PHONE1_ID=
# MULTI_DEVICE_PHONE2_ID=

# 可选：为当前仓库 YAML 的 aiAct 启用经验透明接入。默认关闭。
# 未登记目标、图片 prompt、未知 options 仍走原生。不拦截脚本直接调用 agent.aiAct。
# EXPERIENCE_ENABLED=true

# 可选：指定 hdc 二进制所在目录（@midscene/harmony 按 ${HDC_HOME}/hdc 定位）。
# 未设置时按本机常见安装路径查找。
# HDC_HOME=
