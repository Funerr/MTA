# 复制为 .env 后填写；.env 不入库，CI 中请以环境变量注入。
# 模型四项配置请从官方支持的模型列表复制对应值：
# https://midscenejs.com/model-common-config.html
# 完整环境变量参考：https://midscenejs.com/model-config.html
MIDSCENE_MODEL_BASE_URL=
MIDSCENE_MODEL_API_KEY=
MIDSCENE_MODEL_NAME=
MIDSCENE_MODEL_FAMILY=

# 可选：多台设备在线时，通过 adb devices 查询 udid 并在此指定目标设备。
# 未指定时，仅当恰有一台已授权在线设备时才会自动选择。
ANDROID_DEVICE_ID=
