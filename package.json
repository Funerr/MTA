{
  "name": "mta",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:cases": "node scripts/run-case.mjs --all",
    "case": "node scripts/run-case.mjs",
    "experiment:visual-assert": "vitest run tests/unit/experience-visual-assert.test.ts",
    "nodes": "node scripts/generate-node-references.mjs",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/generate-node-references.mjs",
    "mta:init": "node scripts/init.mjs",
    "test:cases:smoke": "node scripts/run-case.mjs --retired-suite smoke",
    "test:cases:full": "node scripts/run-case.mjs --all",
    "test:cases:level1": "node scripts/run-case.mjs --retired-suite level1",
    "test:cases:level2": "node scripts/run-case.mjs --retired-suite level2",
    "test:cases:level3": "node scripts/run-case.mjs --retired-suite level3",
    "workbench:build": "node scripts/build-workbench-web.mjs && tsc --noEmit -p src/workbench/web/tsconfig.json",
    "workbench": "pnpm workbench:build && tsx src/workbench/cli.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "devDependencies": {
    "@midscene/android": "1.12.7",
    "@midscene/core": "1.12.7",
    "@midscene/harmony": "1.12.7",
    "@midscene/test": "1.12.7",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.0.0",
    "dotenv": "^16.4.5",
    "esbuild": "^0.28.2",
    "exceljs": "^4.4.0",
    "htm": "^3.1.1",
    "marked": "^18.0.13",
    "preact": "^10.29.8",
    "sharp": "0.34.5",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  }
}
