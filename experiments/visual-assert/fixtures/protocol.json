{
  "version": "visual-assert-protocol@1",
  "evalConfigVersion": "visual-assert-eval@1",
  "dataVersion": "visual-assert-fixtures@1",
  "matcherConfigVersion": "visual-matcher@1",
  "go": {
    "falsePassMax": 0,
    "minCoverageBySupportedType": 0.8,
    "unsupportedMustBeUnknown": true,
    "unknownLabelMustBeUnknown": true,
    "noDataOrExecutionErrors": true
  },
  "denominators": {
    "falsePass": "humanLabel === false 的样本数（该类型/本轮）",
    "falseReject": "humanLabel === true 的样本数（该类型/本轮）",
    "unknownRate": "本轮全部样本数",
    "coverage": "semanticType 为 binary-control 或 explicit-text 的样本数（含人工 unknown；不含开放语义）"
  },
  "supportedTypes": [
    "binary-control",
    "explicit-text"
  ],
  "openSemanticRule": "开放语义与未支持类型必须输出 unknown，不得用图像相似度代替语义正确性",
  "ocr": {
    "enabled": false,
    "bundledModel": false,
    "ifEnabledRequire": [
      "modelVersion",
      "languagePackVersion"
    ],
    "unavailableDecision": "unknown",
    "forbidOnlineVlm": true,
    "note": "本实验默认关闭 OCR，文本类走本地模板匹配；仓库不内置 OCR 模型或语言包。"
  },
  "nativeBoundary": {
    "registerExperienceAssert": false,
    "modifyAiAssert": false,
    "writeActionStore": false
  }
}
